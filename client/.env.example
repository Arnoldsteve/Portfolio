# Contact form (POST /api/contact) — set these in Vercel project settings. Never commit real values.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM=
# route=hire|partner go to Steve; route=build goes to SaTechs
CONTACT_TO_STEVE=
CONTACT_TO_SATECHS=

# Placeholder check: production builds (VERCEL_ENV=production) fail while [placeholders] remain,
# unless this is set.
# ALLOW_PLACEHOLDERS=1
